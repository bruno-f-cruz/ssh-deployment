@inherits LayoutComponentBase
@implements IDisposable
@inject RunCoordinator Coordinator
@inject Notifier Notifier
@inject ClientTime ClientTime
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="shell">
    <nav class="nav" aria-label="Main">
        <a class="brand" href="">
            <Logo />
            <span class="brand__name">Shush</span>
        </a>

        <ul class="nav__list">
            <li><a class="nav__link @Active("", "deployments")" href="" aria-current="@Current("", "deployments")"><Icon Name="deploy" />Deployments</a></li>
            <li>
                <a class="nav__link @Active("runs")" href="runs" aria-current="@Current("runs")">
                    <Icon Name="runs" />Runs
                    @if (_activeRuns > 0)
                    {
                        <span class="count" title="Runs in progress">@_activeRuns</span>
                    }
                </a>
            </li>
            <li><a class="nav__link @Active("rigs", "groups", "machines")" href="groups" aria-current="@Current("rigs", "groups", "machines")"><Icon Name="machines" />Rigs</a></li>
            <li><a class="nav__link @Active("recipes")" href="recipes" aria-current="@Current("recipes")"><Icon Name="recipes" />Recipes</a></li>
        </ul>

        <a class="nav__link nav__link--settings @Active("settings", "logs")" href="settings" aria-current="@Current("settings", "logs")"><Icon Name="settings" />Settings</a>
        <div class="nav__footer">
            <SignInPanel />
        </div>
    </nav>

    <main class="main">
        <div class="main__inner">
            <ErrorBoundary @ref="_boundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="ex">
                    <div class="alert alert--error" role="alert">
                        <Icon Name="warn" />
                        <div class="grow">
                            <strong>This page hit an error.</strong>
                            <p class="small">@ex.Message</p>
                        </div>
                        <button type="button" class="btn btn--small" @onclick="Recover">Try again</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </main>
</div>

<div class="toasts" aria-live="polite">
    @foreach (var notice in Notifier.Notices)
    {
        <div class="toast @(notice.Kind == NoticeKind.Error ? "toast--error" : "")" role="@(notice.Kind == NoticeKind.Error ? "alert" : "status")">
            <span class="grow">@notice.Message</span>
            <button type="button" aria-label="Dismiss" @onclick="() => Notifier.Dismiss(notice.Id)">&#10005;</button>
        </div>
    }
</div>

<div id="blazor-error-ui" data-nosnippet>
    The connection to the server had a problem.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#10005;</span>
</div>

@code {
    private ErrorBoundary? _boundary;
    private int _activeRuns;

    protected override void OnInitialized()
    {
        _activeRuns = Coordinator.ActiveRunIds.Count;
        Coordinator.RunChanged += OnRunChanged;
        Notifier.Changed += OnNotice;
        Nav.LocationChanged += OnLocationChanged;
    }

    /// <summary>The first path segment of the current page ("" for the home page).</summary>
    private string Section => Nav.ToBaseRelativePath(Nav.Uri).Split('/', '?', '#')[0].ToLowerInvariant();

    private bool IsIn(string[] sections) => sections.Contains(Section);

    private string Active(params string[] sections) => IsIn(sections) ? "active" : "";

    private string? Current(params string[] sections) => IsIn(sections) ? "page" : null;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || ClientTime.Known)
            return;
        try
        {
            ClientTime.OffsetMinutes = await JS.InvokeAsync<int>("shushTimezoneOffset");
            ClientTime.Known = true;
            StateHasChanged();
        }
        catch (JSException)
        {
            // Times stay in UTC.
        }
    }

    protected override void OnParametersSet() => _boundary?.Recover();

    private void Recover() => _boundary?.Recover();

    private void OnRunChanged(int _) => InvokeAsync(() =>
    {
        var count = Coordinator.ActiveRunIds.Count;
        if (count == _activeRuns) return;
        _activeRuns = count;
        StateHasChanged();
    });

    private void OnNotice() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Coordinator.RunChanged -= OnRunChanged;
        Notifier.Changed -= OnNotice;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
