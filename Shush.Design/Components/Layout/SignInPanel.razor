@implements IDisposable
@inject CredentialStore Credentials

@* The SSH accounts deploys connect with. Deployments that name their own account use it; the others use the first one. *@
@if (_open)
{
    <SignInForm IdPrefix="ssh" OnSignedIn="() => _open = false" OnCancel="() => _open = false" />
}
else if (Credentials.Accounts.Count == 0)
{
    <button type="button" class="btn btn--small" style="align-self: flex-start" @onclick="() => _open = true">
        <Icon Name="lock" Size="16" />Sign in to deploy
    </button>
}
else
{
    <ul class="accounts">
        @foreach (var account in Credentials.Accounts)
        {
            <li class="accounts__item" title="@(account.Remembered ? "Remembered on this browser" : "Signed in for this tab")">
                <Icon Name="user" Size="16" />
                <span class="accounts__name">@account.Username</span>
                <button type="button" class="accounts__out" aria-label="@($"Sign out {account.Username}")" title="Sign out" @onclick="() => Credentials.SignOutAsync(account.Username)">
                    <Icon Name="x" Size="14" />
                </button>
            </li>
        }
    </ul>
    <button type="button" class="link-btn small" style="align-self: flex-start" @onclick="() => _open = true">Add another account</button>
}

@code {
    private bool _open;

    protected override void OnInitialized() => Credentials.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Credentials.LoadAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Credentials.Changed -= OnChanged;
}
