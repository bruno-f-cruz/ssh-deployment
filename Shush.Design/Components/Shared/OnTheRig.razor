@* Marks a variable that is also set as an environment variable on the rig. Recipe-only variables show nothing. *@
@if (ApplyAsEnv)
{
    <span class="badge badge--env" title="@(EnvScope == "User" ? "Set as an environment variable for the SSH user" : "Set as an environment variable for the whole machine")">env @(EnvScope == "User" ? "· user" : "")</span>
}

@code {
    [Parameter] public bool ApplyAsEnv { get; set; }
    [Parameter] public string EnvScope { get; set; } = "Machine";
}
