@* A "⋯" button that opens a short list of secondary actions. Put <button class="menu__item"> or <a class="menu__item"> inside.
   Closes on picking an item, clicking elsewhere, or Escape (shush.js). *@
<details class="menu @Class">
    <summary class="btn @(Label is null ? "btn--icon" : "")" aria-label="@(AriaLabel ?? Label ?? "More actions")" title="@(AriaLabel ?? Label ?? "More actions")">
        @if (Label is null)
        {
            <Icon Name="more" Size="18" />
        }
        else
        {
            @Label <Icon Name="down" Size="14" />
        }
    </summary>
    <div class="menu__list" role="menu">@ChildContent</div>
</details>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>What a screen reader (and the tooltip) calls the button, e.g. \"Actions for step Clone\".</summary>
    [Parameter] public string? AriaLabel { get; set; }
}