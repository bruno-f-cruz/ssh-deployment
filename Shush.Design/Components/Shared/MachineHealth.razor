@* A machine's health from the background probe: reachable, not reachable, or not checked yet. *@
@{
    var tone = ToneOf(Machine);
}
<span class="stack machine-health">
    <StatusText Tone="tone" />
    @if (Detail)
    {
        <span class="small muted">@DetailText(Machine)</span>
    }
</span>

@code {
    [Parameter] public Machine? Machine { get; set; }

    /// <summary>Also show "Last seen 5 min ago" or why it isn't reachable.</summary>
    [Parameter] public bool Detail { get; set; } = true;

    public static Tone ToneOf(Machine? machine) => machine?.Reachable switch
    {
        true => new("ok", "Reachable"),
        false => new("fail", "Not reachable"),
        _ => new("idle", "Not checked yet"),
    };

    public static string DetailText(Machine? machine)
    {
        if (machine is null || machine.Reachable is null)
            return machine?.LastSeenAt is { } seen ? $"Last seen {Ui.Ago(seen)}" : "No probe yet";

        if (machine.Reachable == true)
            return machine.LastSeenAt is { } at ? $"Last seen {Ui.Ago(at)}" : "";

        var why = string.IsNullOrWhiteSpace(machine.ProbeError) ? "no answer on port 22" : machine.ProbeError.TrimEnd('.');
        var seenText = machine.LastSeenAt is { } last ? $" Last seen {Ui.Ago(last)}." : " Never seen.";
        return $"{why}.{seenText}";
    }
}
