@* A destructive action that asks once, inline: the first click turns into "Delete? Delete / Keep". *@
@if (_asking)
{
    <span class="row" role="group" aria-label="@Question">
        <span class="small">@Question</span>
        <button type="button" class="btn btn--small btn--danger" @onclick="ConfirmAsync" disabled="@_busy">@ConfirmLabel</button>
        <button type="button" class="btn btn--small btn--ghost" @onclick="() => _asking = false">Keep</button>
    </span>
}
else
{
    <button type="button" class="@Class" disabled="@Disabled" title="@Title" aria-label="@AriaLabel" @onclick="() => _asking = true">@ChildContent</button>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Question { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmLabel { get; set; } = "Delete";
    [Parameter] public string Class { get; set; } = "btn btn--danger";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private bool _asking;
    private bool _busy;

    private async Task ConfirmAsync()
    {
        _busy = true;
        try
        {
            await OnConfirm.InvokeAsync();
        }
        finally
        {
            _busy = false;
            _asking = false;
        }
    }
}
