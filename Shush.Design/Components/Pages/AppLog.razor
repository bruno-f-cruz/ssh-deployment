@page "/logs"
@inject AppLogPath LogPath
@implements IDisposable

<PageTitle>Application log · Shush</PageTitle>

<PageHeader Title="Application log">
    <Crumbs><a href="settings">Settings</a> / Application log</Crumbs>
    <Lede>App-level messages: the machine registry, startup, unexpected errors. Each run has its own log on its page.</Lede>
    <Actions><button type="button" class="btn" @onclick="Refresh">Refresh</button></Actions>
</PageHeader>

<section class="panel">
    <pre class="log log--tall">@(string.IsNullOrEmpty(_content) ? "No entries yet." : _content)</pre>
</section>

@code {
    private string _content = "";
    private Timer? _timer;

    protected override void OnInitialized()
    {
        Refresh();
        _timer = new Timer(_ => InvokeAsync(Refresh), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void Refresh()
    {
        var text = RunLogReader.Whole(LogPath.Path);
        // The newest entries matter most; keep the page light.
        _content = text.Length > 200_000 ? text[^200_000..] : text;
        StateHasChanged();
    }

    public void Dispose() => _timer?.Dispose();
}
