@page "/logs"
@inject AppLogPath LogPath
@implements IDisposable

<PageTitle>Application log · Shush</PageTitle>

<PageHeader Title="Application log">
    <Crumbs><a href="settings">Settings</a> / Application log</Crumbs>
    <Facts><p class="meta"><span class="mono small">@LogPath.Path</span><span>updates every 5 s</span></p></Facts>
</PageHeader>

<pre class="log log--tall applog">@(string.IsNullOrEmpty(_content) ? "No entries yet." : _content)</pre>

@code {
    private string _content = "";
    private Timer? _timer;

    protected override void OnInitialized()
    {
        Refresh();
        _timer = new Timer(_ => InvokeAsync(Refresh), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void Refresh()
    {
        var text = RunLogReader.Whole(LogPath.Path);
        // The newest entries matter most; keep the page light.
        _content = text.Length > 200_000 ? text[^200_000..] : text;
        StateHasChanged();
    }

    public void Dispose() => _timer?.Dispose();
}
