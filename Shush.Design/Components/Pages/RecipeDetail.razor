@page "/recipes/{Id:int}"
@using Shush.Design.Components.Recipes
@inject RecipeService RecipeService
@inject DeploymentService DeploymentService
@inject CredentialStore Credentials
@inject Notifier Notifier
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_recipe?.Name ?? "Recipe") · Recipes · Shush</PageTitle>

<NavigationLock ConfirmExternalNavigation="@(_draft is not null && Dirty)" OnBeforeInternalNavigation="OnBeforeNavigation" />

@if (_notFound)
{
    <PageHeader Title="Recipe not found">
        <Crumbs><a href="recipes">Recipes</a></Crumbs>
    </PageHeader>
    <section class="panel">
        <EmptyState Title="There's no recipe with that id">
            It may have been deleted. <a href="recipes">Back to recipes</a>
        </EmptyState>
    </section>
}
else if (_recipe is null || _current is null || _draft is null)
{
    <p class="muted">Loading recipe…</p>
}
else
{
    <PageHeader Title="@_recipe.Name">
        <Crumbs><a href="recipes">Recipes</a> / @_recipe.Name</Crumbs>
        <Facts>
            <p class="meta">
                <span>v@(_current.Number)</span>
                <span title="@_recipe.UpdatedAt.ToString("u")">updated @Ui.Ago(_recipe.UpdatedAt)</span>
                @if (_deployments.Count > 0)
                {
                    <span><button type="button" class="link-btn meta__link" @onclick="@(() => SelectTab("used-by"))">used by @Ui.Plural(_deployments.Count, "deployment")</button></span>
                }
                else
                {
                    <span>not used yet</span>
                }
                @if (_recipe.IsBuiltIn)
                {
                    <span>built in</span>
                }
                else if (_recipe.CopiedFrom is not null)
                {
                    <span>copy of @_recipe.CopiedFrom</span>
                }
            </p>
        </Facts>
        <Actions>
            <Menu>
                <button type="button" class="menu__item" @onclick="Export"><Icon Name="download" />Export .yml</button>
                <button type="button" class="menu__item" @onclick="StartDuplicate" disabled="@_busy"><Icon Name="copy" />Duplicate</button>
                @if (!_recipe.IsBuiltIn)
                {
                    <button type="button" class="menu__item" @onclick="StartRename" disabled="@_busy"><Icon Name="log" />Rename</button>
                }
                @if (ShippedDiffers)
                {
                    <div class="menu__sep"></div>
                    <button type="button" class="menu__item" @onclick="@(() => _confirm = "reset")" disabled="@_busy"><Icon Name="rollback" />Reset to default</button>
                }
                @if (!_recipe.IsBuiltIn)
                {
                    <div class="menu__sep"></div>
                    <button type="button" class="menu__item menu__item--danger" @onclick="@(() => _confirm = "delete")" disabled="@_busy"><Icon Name="trash" />Delete</button>
                }
            </Menu>
        </Actions>
    </PageHeader>

    @if (_pendingNavigation is not null)
    {
        <div class="alert alert--warn" role="alert">
            <Icon Name="warn" />
            <div class="grow"><strong>Unsaved changes.</strong> Save them first, or leave and lose them.</div>
            <button type="button" class="btn btn--small btn--danger" @onclick="LeaveAnyway">Leave without saving</button>
            <button type="button" class="btn btn--small btn--ghost" @onclick="() => _pendingNavigation = null">Stay</button>
        </div>
    }

    @if (_confirm is not null)
    {
        <div class="alert alert--warn" role="alert">
            <Icon Name="warn" />
            <div class="grow">@(_confirm == "delete" ? $"Delete {_recipe.Name}? This can't be undone." : ResetQuestion)</div>
            @if (_confirm == "delete")
            {
                <button type="button" class="btn btn--small btn--danger" @onclick="Delete" disabled="@_busy">Delete</button>
            }
            else
            {
                <button type="button" class="btn btn--small btn--primary" @onclick="ResetToShipped" disabled="@_busy">Reset to default</button>
            }
            <button type="button" class="btn btn--small btn--ghost" @onclick="() => _confirm = null">Keep</button>
        </div>
    }

    @if (_actionError is not null)
    {
        <div class="alert alert--error" role="alert">
            <Icon Name="warn" />
            <div class="grow">@_actionError</div>
            <button type="button" class="btn btn--icon" @onclick="() => _actionError = null" aria-label="Dismiss"><Icon Name="x" /></button>
        </div>
    }

    @if (_renaming)
    {
        <section class="panel" aria-label="Rename recipe">
            <form class="inline-form" @onsubmit="Rename" @onsubmit:preventDefault="true">
                <div class="field">
                    <label for="rename-input">New name</label>
                    <input id="rename-input" @bind="_renameName" autocomplete="off" />
                    @if (_renameError is not null)
                    {
                        <span class="field__error">@_renameError</span>
                    }
                    else if (Dirty)
                    {
                        <span class="field__hint t-warn">Save or discard your changes first.</span>
                    }
                    else
                    {
                        <span class="field__hint">Deployments keep using it.</span>
                    }
                </div>
                <button type="submit" class="btn btn--primary" disabled="@(Dirty || _busy)">Rename</button>
                <button type="button" class="btn btn--ghost" @onclick="() => _renaming = false">Cancel</button>
            </form>
        </section>
    }

    @if (_duplicating)
    {
        <section class="panel" aria-label="Duplicate recipe">
            <DuplicateRecipeForm RecipeId="_recipe.Id" SourceName="@_recipe.Name" SourceVersion="_current.Number" Disabled="@(Dirty || _busy)"
                                 Hint="@(Dirty ? "Save or discard your changes first; the copy is made from the saved version." : null)"
                                 OnCancel="() => _duplicating = false" />
        </section>
    }

    @if (ShippedDiffers && _confirm is null)
    {
        <div class="alert alert--info">
            <Icon Name="info" />
            <div class="grow" title="The app may have been updated, or someone edited it here. Resetting keeps the current version in the history.">
                Differs from the version that ships with the app.
            </div>
            <button type="button" class="btn btn--small" @onclick="@(() => _confirm = "reset")" disabled="@_busy">Reset to default</button>
        </div>
    }

    <div class="recipe-tabs">
        <div class="tabs" role="tablist" aria-label="Recipe">
            @foreach (var (key, label) in Tabs)
            {
                <button type="button" role="tab" id="tab-@key" class="tab" aria-selected="@Ui.Aria(_tab == key ? "true" : "false")" aria-controls="panel-@key"
                        @onclick="() => SelectTab(key)">
                    @label
                    @if (key == "editor" && Dirty)
                    {
                        <span class="dirty-dot" title="Unsaved changes" aria-label="unsaved changes"></span>
                    }
                </button>
            }
        </div>
        @if (_tab == "editor")
        {
            <div class="recipe-tabs__tools">
                <div class="seg" role="group" aria-label="Editor view">
                    <button type="button" class="seg__btn" aria-pressed="@Ui.Aria(!_raw ? "true" : "false")" @onclick="() => SetRaw(false)">Structured</button>
                    <button type="button" class="seg__btn" aria-pressed="@Ui.Aria(_raw ? "true" : "false")" @onclick="() => SetRaw(true)">YAML</button>
                </div>
                @if (Dirty)
                {
                    <button type="button" class="btn btn--small btn--ghost" @onclick="Discard" disabled="@_busy">Discard</button>
                    <button type="button" class="btn btn--small btn--primary" @onclick="Save" disabled="@(_errors.Count > 0 || _busy)"
                            title="@(_errors.Count > 0 ? "Fix the problems listed below first." : null)">
                        Save
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn--small" disabled title="No unsaved changes">Save</button>
                }
            </div>
        }
    </div>

    @if (_tab == "editor")
    {
        <div id="panel-editor" role="tabpanel" aria-labelledby="tab-editor" class="stack">
            @if (_errors.Count > 0)
            {
                <div class="alert alert--error" role="alert">
                    <Icon Name="warn" />
                    <div class="grow">
                        <strong>@(_errors.Count == 1 ? "Fix this before saving:" : $"Fix these {_errors.Count} problems before saving:")</strong>
                        <ul>
                            @foreach (var error in _errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                </div>
            }

            @if (_raw)
            {
                <div class="yaml-editor" title="Checked as you type. The recipe language is described in docs/recipes.md.">
                    <pre id="recipe-yaml-pre" aria-hidden="true"></pre>
                    <textarea id="recipe-yaml" spellcheck="false" aria-label="Recipe YAML"
                              @bind="_rawYaml" @bind:event="oninput" @bind:after="ValidateRaw"></textarea>
                </div>
            }
            else
            {
                <div class="columns">
                    <section class="panel wide" aria-label="Steps">
                        <StepEditor @ref="_stepEditor" Draft="_draft" Errors="_errors" OnChanged="OnDraftChanged" />
                    </section>
                    <section class="panel narrow" aria-label="Parameters">
                        <ParamEditor @ref="_paramEditor" Draft="_draft" OnChanged="OnDraftChanged" />
                    </section>
                </div>
            }
        </div>
    }
    else if (_tab == "history")
    {
        <div id="panel-history" role="tabpanel" aria-labelledby="tab-history" class="stack">
            <RecipeHistory Versions="_versions" CopiedFrom="@_recipe.CopiedFrom" OnRestore="Restore" />
        </div>
    }
    else
    {
        <div id="panel-used-by" role="tabpanel" aria-labelledby="tab-used-by">
            <section class="panel panel--flush" aria-label="Deployments using this recipe">
                @if (_deployments.Count == 0)
                {
                    <EmptyState Title="No deployments use this recipe yet.">
                        <Actions><a class="btn btn--small" href="deployments/new?recipe=@Id"><Icon Name="plus" />New deployment</a></Actions>
                    </EmptyState>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">Deployment</th>
                                    <th scope="col">Group</th>
                                    <th scope="col" class="num">Machines</th>
                                    <th scope="col">Last run</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _deployments)
                                {
                                    <tr class="is-link">
                                        <td>
                                            <a class="row-link" href="deployments/@d.Id">@d.Name</a>
                                            @if (!string.IsNullOrWhiteSpace(d.Description))
                                            {
                                                <div class="sub">@d.Description</div>
                                            }
                                        </td>
                                        <td><a href="groups/@d.GroupId">@d.GroupName</a></td>
                                        <td class="num">@d.MachineCount</td>
                                        <td>
                                            @if (d.LastRun is { } run)
                                            {
                                                <a href="runs/@run.RunId" class="status-link"><StatusText Tone="Ui.Of(run.Status)" /></a>
                                                <span class="muted small">@Ui.Kind(run.Kind), @Ui.Ago(run.StartedAt)</span>
                                            }
                                            else
                                            {
                                                <span class="muted">Never run</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="recipe-usedby__foot">
                        <a class="btn btn--small btn--ghost" href="deployments/new?recipe=@Id"><Icon Name="plus" />New deployment</a>
                    </div>
                }
            </section>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    /// <summary><c>editor</c> (default), <c>history</c> or <c>used-by</c>.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    /// <summary><c>raw</c> opens the editor in Raw YAML (a new recipe does).</summary>
    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    private static readonly (string Key, string Label)[] Tabs = [("editor", "Editor"), ("history", "History"), ("used-by", "Used by")];

    private Recipe? _recipe;
    private RecipeVersion? _current;
    private List<RecipeVersion> _versions = [];
    private List<DeploymentSummary> _deployments = [];
    private bool _notFound;
    private int? _loadedId;
    private string _tab = "editor";
    private bool _busy;
    private string? _actionError;

    // The draft, and the saved YAML it started from (as stored, and as the serializer writes it).
    private RecipeDraft? _draft;
    private string _savedYaml = "";
    private string _savedNormalized = "";
    private IReadOnlyList<string> _errors = [];
    private bool _raw;
    private string _rawYaml = "";
    private bool _rawNeedsInit;
    private StepEditor? _stepEditor;
    private ParamEditor? _paramEditor;

    private bool _renaming;
    private string _renameName = "";
    private string? _renameError;

    private bool _duplicating;

    /// <summary>"delete" or "reset" while asking to confirm one picked from the ⋯ menu.</summary>
    private string? _confirm;

    private string? _pendingNavigation;
    private bool _leaving;

    private bool ShippedDiffers =>
        _recipe is { IsBuiltIn: true, ShippedHash: not null } && _current is not null && _recipe.ShippedHash != _current.Hash;

    private string ResetQuestion => Dirty
        ? "Reset to the shipped version? Your unsaved changes will be lost."
        : "Reset to the shipped version? The current one stays in the history.";

    private bool DirtyStructured => _draft is not null && _draft.ToYaml() != _savedNormalized;

    private bool Dirty => _raw ? _rawYaml != _savedYaml && _rawYaml != _savedNormalized : DirtyStructured;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
            return;
        _loadedId = Id;
        _renaming = false;
        _duplicating = false;
        _confirm = null;
        _actionError = null;
        _tab = Tabs.Any(t => t.Key == Tab) ? Tab! : "editor";
        _raw = string.Equals(Mode, "raw", StringComparison.OrdinalIgnoreCase);
        await LoadAsync(resetEditor: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_rawNeedsInit && _raw && _tab == "editor" && _draft is not null)
        {
            _rawNeedsInit = false;
            await JS.InvokeVoidAsync("shushYaml.init", "recipe-yaml", "recipe-yaml-pre");
        }
    }

    private async Task LoadAsync(bool resetEditor)
    {
        _recipe = await RecipeService.GetAsync(Id);
        if (_recipe is null)
        {
            _notFound = true;
            return;
        }

        _notFound = false;
        _versions = await RecipeService.VersionsAsync(Id);
        _current = _versions[0];
        _deployments = await DeploymentService.ListAsync(recipeId: Id);
        if (resetEditor || _draft is null)
            LoadDraft(_current.Yaml);
    }

    /// <summary>Starts editing from saved YAML, throwing away any draft.</summary>
    private void LoadDraft(string yaml)
    {
        _savedYaml = yaml;
        try
        {
            _draft = RecipeDraft.FromYaml(yaml, RecipeService.Validator);
            _savedNormalized = _draft.ToYaml();
            _errors = _draft.Validate();
        }
        catch (Exception ex) when (ex is not RecipeValidationException)
        {
            // Stored YAML that no longer parses can still be fixed by hand.
            _draft = new RecipeDraft(new RecipeDocument { Name = _recipe?.Name ?? "" }, RecipeService.Validator);
            _savedNormalized = yaml;
            _errors = [$"YAML parse error: {ex.Message}"];
            _raw = true;
        }

        _rawYaml = yaml;
        _rawNeedsInit = true;
        _stepEditor?.Reset();
        _paramEditor?.Reset();
    }

    private void SelectTab(string key)
    {
        _tab = key;
        if (key == "editor")
            _rawNeedsInit = true;
    }

    // ---- Editing ----

    private void OnDraftChanged() => _errors = _draft!.Validate();

    private void ValidateRaw()
    {
        if (_draft!.TryApplyRawYaml(_rawYaml, out var errors))
            _errors = [];
        else
            _errors = errors;
    }

    private void SetRaw(bool raw)
    {
        if (raw == _raw)
            return;

        if (raw)
        {
            // Unchanged: show the stored text, comments and all. Changed: show what the structured edits produce.
            _rawYaml = DirtyStructured ? _draft!.ToYaml() : _savedYaml;
            _raw = true;
            _rawNeedsInit = true;
            return;
        }

        if (!_draft!.TryApplyRawYaml(_rawYaml, out var errors))
        {
            _errors = errors;
            Notifier.Error("The YAML has problems, so it can't be shown as structured steps yet. Fix the errors listed, then switch.");
            return;
        }

        _errors = [];
        _raw = false;
        _stepEditor?.Reset();
        _paramEditor?.Reset();
    }

    private void Discard()
    {
        LoadDraft(_savedYaml);
        Notifier.Info("Changes discarded.");
    }

    private async Task Save()
    {
        string yaml;
        if (_raw)
        {
            ValidateRaw();
            if (_errors.Count > 0)
                return;
            yaml = _rawYaml; // keeps the comments
        }
        else
        {
            yaml = _draft!.ToYaml();
        }

        _busy = true;
        try
        {
            var previous = _current!.Number;
            var version = await RecipeService.SaveAsync(Id, yaml, VersionSource.Edit, Credentials.Username);
            await LoadAsync(resetEditor: true);
            if (version.Number == previous)
                Notifier.Info("Nothing changed, so no new version was saved.");
            else
                Notifier.Success($"Saved {_recipe!.Name} as v{version.Number}.");
        }
        catch (RecipeValidationException ex)
        {
            _errors = ex.Errors;
        }
        catch (ShushDataException ex)
        {
            _errors = [ex.Message];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Export()
    {
        var content = _raw ? _rawYaml : DirtyStructured ? _draft!.ToYaml() : _savedYaml;
        var name = string.Concat(_recipe!.Name.Split(Path.GetInvalidFileNameChars()));
        await JS.InvokeVoidAsync("downloadFile", $"{name}.yml", content, "text/yaml");
    }

    // ---- Recipe actions ----

    private async Task RunAction(Func<Task> action)
    {
        _actionError = null;
        _busy = true;
        try
        {
            await action();
        }
        catch (ShushDataException ex)
        {
            _actionError = ex.Message;
        }
        catch (RecipeValidationException ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ResetToShipped() => RunAction(async () =>
    {
        _confirm = null;
        var version = await RecipeService.ResetToShippedAsync(Id, Credentials.Username);
        await LoadAsync(resetEditor: true);
        Notifier.Success($"Reset {_recipe!.Name} to the shipped version, saved as v{version.Number}.");
    });

    private Task Restore(RecipeVersion old) => RunAction(async () =>
    {
        var previous = _current!.Number;
        var version = await RecipeService.RestoreAsync(old.Id, Credentials.Username);
        await LoadAsync(resetEditor: true);
        if (version.Number == previous)
            Notifier.Info($"v{old.Number} is the same as the current version, so nothing changed.");
        else
            Notifier.Success($"Restored v{old.Number} as v{version.Number}.");
    });

    private void StartDuplicate()
    {
        _confirm = null;
        _renaming = false;
        _duplicating = true;
    }

    private void StartRename()
    {
        _confirm = null;
        _duplicating = false;
        _renameName = _recipe!.Name;
        _renameError = null;
        _renaming = true;
    }

    private async Task Rename()
    {
        _renameError = null;
        var name = _renameName.Trim();
        if (string.Equals(name, _recipe!.Name, StringComparison.Ordinal))
        {
            _renaming = false;
            return;
        }

        _busy = true;
        try
        {
            await RecipeService.RenameAsync(Id, name, Credentials.Username);
            await LoadAsync(resetEditor: true);
            _renaming = false;
            Notifier.Success($"Renamed to {_recipe!.Name}.");
        }
        catch (ShushDataException ex)
        {
            _renameError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task Delete() => RunAction(async () =>
    {
        _confirm = null;
        var name = _recipe!.Name;
        await RecipeService.DeleteAsync(Id);
        Notifier.Success($"Deleted {name}.");
        _leaving = true;
        Nav.NavigateTo("recipes");
    });

    // ---- Unsaved changes ----

    private void OnBeforeNavigation(LocationChangingContext context)
    {
        if (_leaving || _draft is null || !Dirty)
            return;
        context.PreventNavigation();
        _pendingNavigation = context.TargetLocation;
    }

    private void LeaveAnyway()
    {
        var target = _pendingNavigation;
        _pendingNavigation = null;
        _leaving = true;
        if (target is not null)
            Nav.NavigateTo(target);
    }
}
