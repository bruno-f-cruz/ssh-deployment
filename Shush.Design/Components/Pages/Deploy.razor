@page "/"
@using Shush.Recipe
@using Shush.Design.Services
@inject MachineRegistryService Registry
@inject RecipeStateStore StateStore
@inject DeploymentOrchestrator Orchestrator
@inject IJSRuntime JS
@inject ILogger<Deploy> Logger

<PageTitle>Shush.Design</PageTitle>

<div class="app-shell">
    <header class="app-header">
        <div>
            <h1>Shush.Design</h1>
            <p class="app-header__subtitle">
                Deploy Shush recipes to lab rigs from the browser.
                <a href="/logs">Application log &rarr;</a>
            </p>
        </div>
        <div class="field">
            <label for="recipe-select">Recipe</label>
            <select id="recipe-select" value="@(_selectedRecipe?.Name ?? string.Empty)" @onchange="OnRecipeSelected">
                <option value="">Select a recipe…</option>
                @foreach (var recipe in _recipes)
                {
                    <option value="@recipe.Name">@recipe.Name</option>
                }
            </select>
        </div>
    </header>

    @if (_errorMessage is not null)
    {
        <div class="alert alert--error" role="alert">
            <span>@_errorMessage</span>
            <button type="button" class="btn btn--icon" @onclick="() => _errorMessage = null" aria-label="Dismiss error">&#10005;</button>
        </div>
    }

    @if (_selectedRecipe is null)
    {
        <p class="empty-state">Select a recipe above to get started.</p>
    }
    else
    {
        <main class="app-main">
            <section class="card" aria-labelledby="properties-heading">
                <div class="card__header">
                    <h2 id="properties-heading">Properties</h2>
                    <div class="inline-add">
                        <button type="button" class="btn btn--secondary" @onclick="DownloadConfig">Download config</button>
                        <label class="btn btn--ghost file-btn">
                            Upload config
                            <InputFile OnChange="OnConfigUpload" class="visually-hidden" />
                        </label>
                    </div>
                </div>

                @if (_properties.Count == 0)
                {
                    <p class="empty-state">This recipe has no configurable properties.</p>
                }
                else
                {
                    <div class="field-grid">
                        @foreach (var property in _properties)
                        {
                            <div class="field">
                                <label for="@FieldId(property)">@property.Label</label>
                                @switch (property.Kind)
                                {
                                    case PropertyEditorKind.Text:
                                        <input id="@FieldId(property)"
                                               value="@property.GetValueAsString(_selectedRecipe)"
                                               @onchange="e => OnPropertyChanged(property, e)" />
                                        break;
                                    case PropertyEditorKind.Dropdown:
                                        <select id="@FieldId(property)"
                                                value="@property.GetValueAsString(_selectedRecipe)"
                                                @onchange="e => OnPropertyChanged(property, e)">
                                            @foreach (var option in property.GetDropdownOptions())
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                        break;
                                    case PropertyEditorKind.Collection:
                                        <ul class="chip-list">
                                            @foreach (var item in property.GetOrCreateList(_selectedRecipe).Cast<object>().ToList())
                                            {
                                                <li class="chip">
                                                    @property.ConvertElementToString(item)
                                                    <button type="button" class="chip__remove" @onclick="() => RemoveListItem(property, item)" aria-label="Remove value">&#10005;</button>
                                                </li>
                                            }
                                        </ul>
                                        <div class="inline-add">
                                            <input id="@FieldId(property)"
                                                   value="@GetCollectionInput(property)"
                                                   @onchange="e => SetCollectionInput(property, e)" placeholder="Add value" />
                                            <button type="button" class="btn btn--secondary" @onclick="() => AddListItem(property)">Add</button>
                                        </div>
                                        break;
                                }
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="card" aria-labelledby="machines-heading">
                <div class="card__header">
                    <h2 id="machines-heading">Machines</h2>
                    <form class="inline-add" @onsubmit="AddMachine" @onsubmit:preventDefault="true">
                        <label for="machine-name" class="visually-hidden">Machine name</label>
                        <input id="machine-name" placeholder="e.g. FRG.4-A" autocomplete="off" list="machine-options"
                               @bind="_newMachineName" @bind:event="oninput" />
                        <datalist id="machine-options">
                            @foreach (var name in _availableMachineNames.Except(_machines.Select(m => m.Name)))
                            {
                                <option value="@name" />
                            }
                        </datalist>
                        <button type="submit" class="btn btn--secondary">Add</button>
                        <label class="btn btn--ghost file-btn">
                            Load from YAML
                            <InputFile OnChange="OnYamlUpload" class="visually-hidden" />
                        </label>
                        <button type="button" class="btn btn--ghost" disabled="@(_machines.Count == 0)" @onclick="ExportMachines">Export to YAML</button>
                    </form>
                </div>

                @if (_machines.Count == 0)
                {
                    <p class="empty-state">No machines yet — add one above or load a YAML file.</p>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="machines-table">
                            <thead>
                                <tr>
                                    <th scope="col">Machine</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Progress</th>
                                    <th scope="col">Detail</th>
                                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var machine in _machines)
                                {
                                    var (icon, label) = StatusDisplay(machine.Status);
                                    var percent = _progress is { TotalSteps: > 0 }
                                        ? (int)(100.0 * machine.CompletedStepCount / _progress.TotalSteps)
                                        : 0;

                                    <tr>
                                        <td data-label="Machine">@machine.Name</td>
                                        <td data-label="Status">
                                            <span class="badge badge--@(machine.Status.ToString().ToLowerInvariant())">
                                                <span aria-hidden="true" class="badge__icon@(machine.Status == RowStatus.Running ? " spin" : "")">@icon</span>
                                                @label
                                            </span>
                                        </td>
                                        <td data-label="Progress">
                                            @if (machine.Status is RowStatus.Running or RowStatus.Success or RowStatus.Failed)
                                            {
                                                <div class="progress-track" role="progressbar"
                                                     aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"
                                                     aria-label="@($"{machine.Name} deployment progress")">
                                                    <div class="progress-fill progress-fill--@(machine.Status.ToString().ToLowerInvariant())" style="width: @(percent)%"></div>
                                                </div>
                                                <span class="progress-label text-muted">@percent%</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td data-label="Detail">
                                            @if (machine.Status is RowStatus.Invalid or RowStatus.Failed && machine.LastCompletedStep() is null && machine.Error is not null)
                                            {
                                                <span class="text-danger">@machine.Error</span>
                                            }
                                            else if (machine.Status == RowStatus.Running)
                                            {
                                                <span class="text-muted">@machine.CurrentStep</span>
                                            }
                                            else if (machine.LastCompletedStep() is { } last)
                                            {
                                                <span class="@(last.Success ? "text-muted" : "text-danger")">@last.StepName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td data-label="">
                                            @if (machine.Status is RowStatus.Ready or RowStatus.Invalid)
                                            {
                                                <button type="button" class="btn btn--icon" @onclick="() => RemoveMachine(machine)" aria-label="@($"Remove {machine.Name}")">&#10005;</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn--link" @onclick="() => ToggleExpand(machine.Name)" aria-expanded="@_expanded.Contains(machine.Name)">
                                                    @(_expanded.Contains(machine.Name) ? "Hide log" : "View log")
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                    @if (_expanded.Contains(machine.Name))
                                    {
                                        <tr class="log-row">
                                            <td colspan="5">
                                                <pre class="log-panel" id="@LogElementId(machine.Name)">@GetMachineLog(machine.Name)</pre>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="deploy-bar">
                    <p class="deploy-summary" aria-live="polite">@DeploySummary</p>
                    <button type="button" class="btn btn--primary" disabled="@(!CanDeploy)" @onclick="StartDeployment">
                        @(_deploying ? "Deploying…" : "Deploy")
                    </button>
                </div>
            </section>
        </main>
    }
</div>

@code {
    private List<IRecipe> _recipes = [];
    private IRecipe? _selectedRecipe;
    private List<RecipeProperty> _properties = [];
    private List<MachineRow> _machines = [];
    private List<string> _availableMachineNames = [];
    private string _newMachineName = string.Empty;
    private readonly Dictionary<string, string> _collectionInputs = new();
    private readonly HashSet<string> _expanded = new();
    private BlazorDeploymentProgress? _progress;
    private bool _deploying;
    private string? _errorMessage;

    private bool CanDeploy => _selectedRecipe is not null && !_deploying && _machines.Any(m => m.Status == RowStatus.Ready);

    private string DeploySummary
    {
        get
        {
            var ready = _machines.Count(m => m.Status == RowStatus.Ready);
            if (_progress is null) return $"{ready} machine(s) ready to deploy.";

            var success = _machines.Count(m => m.Status == RowStatus.Success);
            var failed = _machines.Count(m => m.Status == RowStatus.Failed);
            var running = _machines.Count(m => m.Status == RowStatus.Running);

            return _deploying
                ? $"Deploying… {success} succeeded, {failed} failed, {running} running."
                : $"Finished: {success} succeeded, {failed} failed.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _recipes = RecipeCatalog.Discover();

        try
        {
            _availableMachineNames = await Registry.GetAllNamesAsync();
        }
        catch (Exception ex)
        {
            // Registry unreachable — autocomplete just has no suggestions, add-by-name still works.
            Logger.LogError(ex, "Couldn't load machine names from the registry for autocomplete.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        foreach (var name in _expanded)
            await JS.InvokeVoidAsync("scrollLogToBottom", LogElementId(name));
    }

    private static (string Icon, string Label) StatusDisplay(RowStatus status) => status switch
    {
        RowStatus.Ready => ("●", "Ready"),
        RowStatus.Invalid => ("⚠", "Invalid"),
        RowStatus.Running => ("↻", "Running"),
        RowStatus.Success => ("✓", "Success"),
        RowStatus.Failed => ("✕", "Failed"),
        _ => ("", ""),
    };

    private static string FieldId(RecipeProperty property) => $"prop-{property.Info.Name}";

    private static string LogElementId(string machineName) => $"log-{machineName.Replace('.', '-')}";

    private async Task OnRecipeSelected(ChangeEventArgs e)
    {
        _errorMessage = null;
        var name = e.Value?.ToString();
        _selectedRecipe = _recipes.FirstOrDefault(r => r.Name == name);
        _properties = _selectedRecipe is null ? [] : RecipeFormBinder.GetSettableProperties(_selectedRecipe);
        _machines = [];
        _progress = null;
        _expanded.Clear();
        _collectionInputs.Clear();

        if (_selectedRecipe is null) return;

        var state = StateStore.Load(_selectedRecipe.Name);
        if (state is null) return;

        await ApplyState(state);
    }

    private async Task ApplyState(RecipeState state)
    {
        if (_selectedRecipe is null) return;

        foreach (var propertyValue in state.Properties)
        {
            var property = _properties.FirstOrDefault(p => p.Info.Name == propertyValue.Name);
            property?.SetValueFromString(_selectedRecipe, propertyValue.Value);
        }

        try
        {
            foreach (var machineName in state.Machines)
            {
                if (_machines.Any(m => m.Name == machineName)) continue;
                _machines.Add(await Registry.ResolveAsync(machineName));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Couldn't resolve machines for recipe '{Recipe}' from the registry.", _selectedRecipe.Name);
            _errorMessage = $"Couldn't reach the machine registry: {ex.Message}";
        }
    }

    private void OnPropertyChanged(RecipeProperty property, ChangeEventArgs e)
    {
        property.SetValueFromString(_selectedRecipe!, e.Value?.ToString() ?? string.Empty);
        SaveState();
    }

    private string GetCollectionInput(RecipeProperty property) =>
        _collectionInputs.GetValueOrDefault(property.Info.Name, string.Empty);

    private void SetCollectionInput(RecipeProperty property, ChangeEventArgs e) =>
        _collectionInputs[property.Info.Name] = e.Value?.ToString() ?? string.Empty;

    private void AddListItem(RecipeProperty property)
    {
        var text = GetCollectionInput(property);
        if (string.IsNullOrWhiteSpace(text)) return;

        property.GetOrCreateList(_selectedRecipe!).Add(property.ConvertElementFromString(text));
        _collectionInputs[property.Info.Name] = string.Empty;
        SaveState();
    }

    private void RemoveListItem(RecipeProperty property, object item)
    {
        property.GetOrCreateList(_selectedRecipe!).Remove(item);
        SaveState();
    }

    private async Task AddMachine()
    {
        _errorMessage = null;
        var name = _newMachineName.Trim();
        if (string.IsNullOrEmpty(name) || _machines.Any(m => m.Name == name)) return;

        try
        {
            _machines.Add(await Registry.ResolveAsync(name));
            _newMachineName = string.Empty;
            SaveState();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Couldn't resolve machine '{Machine}' against the registry.", name);
            _errorMessage = $"Couldn't reach the machine registry: {ex.Message}";
        }
    }

    private void RemoveMachine(MachineRow machine)
    {
        _machines.Remove(machine);
        SaveState();
    }

    private async Task OnYamlUpload(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream());
            var content = await reader.ReadToEndAsync();

            foreach (var name in Registry.ParseYaml(content))
            {
                if (_machines.Any(m => m.Name == name)) continue;
                _machines.Add(await Registry.ResolveAsync(name));
            }

            SaveState();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Couldn't load machines from uploaded YAML file '{FileName}'.", e.File.Name);
            _errorMessage = $"Couldn't load machines from that file: {ex.Message}";
        }
    }

    private async Task ExportMachines()
    {
        var yaml = Registry.SerializeYaml(_machines.Select(m => m.Name));
        await JS.InvokeVoidAsync("downloadFile", "machines.yaml", yaml, "text/yaml");
    }

    private async Task DownloadConfig()
    {
        if (_selectedRecipe is null) return;

        var xml = StateStore.SerializeToXml(_selectedRecipe, _properties, _machines.Select(m => m.Name));
        var fileName = $"{_selectedRecipe.Name}.config.xml";
        await JS.InvokeVoidAsync("downloadFile", fileName, xml, "application/xml");
    }

    private async Task OnConfigUpload(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        if (_selectedRecipe is null) return;

        try
        {
            var state = StateStore.DeserializeXml(e.File.OpenReadStream());
            if (state is null)
            {
                _errorMessage = "That file doesn't look like a valid config export.";
                return;
            }

            await ApplyState(state);
            SaveState();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Couldn't load config from uploaded file '{FileName}'.", e.File.Name);
            _errorMessage = $"Couldn't load that config file: {ex.Message}";
        }
    }

    private void SaveState()
    {
        if (_selectedRecipe is null) return;

        try
        {
            StateStore.Save(_selectedRecipe, _properties, _machines.Select(m => m.Name));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Couldn't save state for recipe '{Recipe}'.", _selectedRecipe.Name);
            _errorMessage = $"Couldn't save your changes: {ex.Message}";
        }
    }

    private async Task StartDeployment()
    {
        if (_selectedRecipe is null) return;

        _errorMessage = null;
        _deploying = true;
        var toDeploy = _machines.Where(m => m.Status == RowStatus.Ready).ToList();
        var totalSteps = _selectedRecipe.Steps.Count();

        _progress = new BlazorDeploymentProgress(toDeploy.ToDictionary(m => m.Name), totalSteps);
        _progress.Changed += OnProgressChanged;

        try
        {
            var machineInfos = toDeploy.ToDictionary(m => m.Name, m => m.Info!);
            await Orchestrator.RunAsync(_selectedRecipe, machineInfos, _progress);
        }
        catch (Exception ex)
        {
            // DeploymentOrchestrator already handles expected per-machine failures internally —
            // reaching here means something unexpected broke before/outside that (e.g. couldn't
            // load credentials).
            Logger.LogError(ex, "Deployment of recipe '{Recipe}' failed to start.", _selectedRecipe.Name);
            _errorMessage = $"Deployment failed to start: {ex.Message}";
        }
        finally
        {
            _progress.Changed -= OnProgressChanged;
            _deploying = false;
            StateHasChanged();
        }
    }

    private void OnProgressChanged() => InvokeAsync(StateHasChanged);

    private void ToggleExpand(string boxId)
    {
        if (!_expanded.Add(boxId)) _expanded.Remove(boxId);
    }

    // FileLoggerProvider only stamps the leading "[BoxId]" tag on the first physical line of a
    // log entry — continuation lines (extra structured-log fields, and the whole exception +
    // stack trace) carry no tag at all. Filtering line-by-line for the tag silently drops that
    // detail, so instead we group lines into whole records (a header line + its untagged
    // continuation lines) and keep/drop an entire record based on its header line.
    private static readonly System.Text.RegularExpressions.Regex LogHeaderPattern =
        new(@"^\[\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\]");

    private static string FilterLogByBoxId(string boxId, IEnumerable<string> lines)
    {
        var tag = $"[{boxId}]";
        var output = new List<string>();
        var include = false;

        foreach (var line in lines)
        {
            if (LogHeaderPattern.IsMatch(line))
                include = line.Contains(tag);
            if (include)
                output.Add(line);
        }

        return string.Join(Environment.NewLine, output);
    }

    private string GetMachineLog(string boxId)
    {
        if (_progress?.LogFilePath is null || !File.Exists(_progress.LogFilePath)) return string.Empty;

        // The deployment's FileLoggerProvider still holds this file open for writing (with
        // FileShare.Read) while a run is in progress, so the reader must explicitly tolerate
        // that existing Write access — File.ReadAllLines's default share doesn't, and throws.
        using var stream = new FileStream(_progress.LogFilePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
        using var reader = new StreamReader(stream);

        var lines = new List<string>();
        string? line;
        while ((line = reader.ReadLine()) is not null)
            lines.Add(line);

        return FilterLogByBoxId(boxId, lines);
    }
}
