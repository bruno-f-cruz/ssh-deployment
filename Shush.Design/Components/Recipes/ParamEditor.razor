@using System.Text.RegularExpressions

@* The recipe's parameters (add, edit, rename, remove) and a read-only list of its vars. *@
<div class="stack">
    <div class="row">
        <h2>Parameters</h2>
        <span class="muted small">Values asked for when deploying, read as <code>${params.name}</code>.</span>
    </div>

    @if (Params.Count == 0)
    {
        <p class="muted">No parameters.</p>
    }

    @foreach (var (name, decl) in Params.ToList())
    {
        var open = _open.Contains(name);
        var prefix = "param-" + name;
        <div @key="decl" class="step-card">
            <div class="step-card__head param-head">
                <button type="button" class="step-card__toggle" @onclick="() => Toggle(name)" aria-expanded="@(open ? "true" : "false")"
                        title="@decl.Label">
                    <span class="chev @(open ? "chev--open" : "")"><Icon Name="chevron" Size="16" /></span>
                    <span class="step-card__type mono">@name</span>
                </button>
                <span class="badge badge--kind">@TypeLabel(decl.Type)</span>
                @if (decl.IsFixed)
                {
                    <span class="locked">fixed</span>
                }
                <button type="button" class="btn btn--icon btn--danger" @onclick="() => Remove(name)" aria-label="Remove parameter @name"><Icon Name="trash" /></button>
            </div>

            @if (open)
            {
                <div class="step-card__body param-body">
                    <div class="field">
                        <label for="@prefix-key">Name</label>
                        <input id="@prefix-key" class="mono" value="@name" autocomplete="off" spellcheck="false" @onchange="e => Rename(name, e)" />
                        @if (_renameError is { } err && err.Name == name)
                        {
                            <span class="field__error">@err.Message</span>
                        }
                        else
                        {
                            <span class="field__hint">Renaming doesn't update <code>${params.@name}</code> references; fix them in the steps.</span>
                        }
                    </div>
                    <div class="field">
                        <label for="@prefix-type">Type</label>
                        <select id="@prefix-type" value="@decl.Type" @onchange="e => SetType(decl, e)">
                            <option value="@ParamType.String">Text</option>
                            <option value="@ParamType.Dropdown">Dropdown</option>
                            <option value="@ParamType.Collection">List</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="@prefix-label">Label</label>
                        <input id="@prefix-label" value="@decl.Label" placeholder="@name" autocomplete="off" @onchange="e => Set(() => decl.Label = Clean(e))" />
                        <span class="field__hint">A short name for the field on the deploy screen.</span>
                    </div>
                    <div class="field">
                        <label for="@prefix-default">Default</label>
                        <input id="@prefix-default" value="@decl.Default" placeholder="none (required)" autocomplete="off" spellcheck="false"
                               @onchange="e => Set(() => decl.Default = Clean(e))" />
                        <span class="field__hint">Leave empty to make the parameter required.</span>
                    </div>
                    <div class="field wide-field">
                        <label for="@prefix-help">Help</label>
                        <input id="@prefix-help" value="@decl.Help" autocomplete="off" @onchange="e => Set(() => decl.Help = Clean(e))" />
                        <span class="field__hint">A sentence shown under the field: what the value means.</span>
                    </div>
                    @if (decl.Type == ParamType.Dropdown)
                    {
                        <div class="field">
                            <label for="@prefix-options">Options</label>
                            <textarea id="@prefix-options" rows="4" spellcheck="false" placeholder="One option per line"
                                      value="@string.Join("\n", decl.Options ?? [])" @onchange="e => SetOptions(decl, e)"></textarea>
                            <span class="field__hint">One option per line.</span>
                        </div>
                    }
                    @if (decl.Type == ParamType.String)
                    {
                        <div class="field">
                            <label for="@prefix-from">Suggestions from</label>
                            <input id="@prefix-from" class="mono" value="@decl.OptionsFrom" placeholder="none" autocomplete="off" spellcheck="false"
                                   @onchange="e => Set(() => decl.OptionsFrom = Clean(e))" />
                            <span class="field__hint">An option source such as <code>clabe.versions</code>. Any other value can still be typed.</span>
                        </div>
                    }
                    <div class="field wide-field">
                        <label class="checkbox">
                            <input type="checkbox" checked="@decl.IsFixed" @onchange="e => Set(() => decl.Fixed = e.Value is true ? true : null)" />
                            Fixed: set once per deployment, then read-only when deploying
                        </label>
                        <span class="field__hint">For values that decide where an install goes, such as its folder, so two deployments never collide.</span>
                    </div>
                </div>
            }
        </div>
    }

    <form class="inline-form" @onsubmit="Add" @onsubmit:preventDefault="true">
        <div class="field">
            <label for="new-param">New parameter</label>
            <input id="new-param" class="mono" @bind="_newName" placeholder="for example tag" autocomplete="off" spellcheck="false" />
            @if (_addError is not null)
            {
                <span class="field__error">@_addError</span>
            }
        </div>
        <button type="submit" class="btn"><Icon Name="plus" />Add parameter</button>
    </form>

    <div class="row vars-head">
        <h2>Vars</h2>
        <span class="muted small">Computed once per machine before the steps, read as <code>${vars.name}</code>. Edit them in Raw YAML.</span>
    </div>
    @if (Draft.Document.Vars.Count == 0)
    {
        <p class="muted">No vars.</p>
    }
    else
    {
        <dl class="kv">
            @foreach (var (name, value) in Draft.Document.Vars)
            {
                <dt class="mono">@name</dt>
                <dd class="mono">@value</dd>
            }
        </dl>
    }
</div>

@code {
    [Parameter, EditorRequired] public RecipeDraft Draft { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private Dictionary<string, ParamDecl> Params => Draft.Document.Params;

    private static readonly Regex NamePattern = new("^[A-Za-z_][A-Za-z0-9_]*$", RegexOptions.Compiled);

    private readonly HashSet<string> _open = new();
    private string _newName = "";
    private string? _addError;
    private (string Name, string Message)? _renameError;

    private static string TypeLabel(ParamType type) => type switch
    {
        ParamType.Dropdown => "Dropdown",
        ParamType.Collection => "List",
        _ => "Text",
    };

    private static string? Clean(ChangeEventArgs e)
    {
        var value = e.Value?.ToString()?.Trim();
        return string.IsNullOrEmpty(value) ? null : value;
    }

    private string? NameProblem(string name, string? except = null)
    {
        if (name.Length == 0)
            return "Enter a name.";
        if (!NamePattern.IsMatch(name))
            return "Use letters, digits and underscores, starting with a letter.";
        if (Params.Keys.Any(k => k != except && string.Equals(k, name, StringComparison.OrdinalIgnoreCase)))
            return $"There's already a parameter named '{name}'.";
        return null;
    }

    private void Toggle(string name)
    {
        if (!_open.Remove(name))
            _open.Add(name);
    }

    private Task Set(Action change)
    {
        change();
        return OnChanged.InvokeAsync();
    }

    private Task SetType(ParamDecl decl, ChangeEventArgs e)
    {
        if (!Enum.TryParse<ParamType>(e.Value?.ToString(), out var type))
            return Task.CompletedTask;
        decl.Type = type;
        if (type != ParamType.Dropdown)
            decl.Options = null;
        if (type != ParamType.String)
            decl.OptionsFrom = null;
        return OnChanged.InvokeAsync();
    }

    private Task SetOptions(ParamDecl decl, ChangeEventArgs e)
    {
        var options = (e.Value?.ToString() ?? "").Split('\n').Select(l => l.Trim()).Where(l => l.Length > 0).ToList();
        decl.Options = options.Count == 0 ? null : options;
        return OnChanged.InvokeAsync();
    }

    private async Task Add()
    {
        var name = _newName.Trim();
        _addError = NameProblem(name);
        if (_addError is not null)
            return;

        Params[name] = new ParamDecl { Type = ParamType.String };
        _open.Add(name);
        _newName = "";
        await OnChanged.InvokeAsync();
    }

    /// <summary>Renames a param in place, keeping the declaration order.</summary>
    private async Task Rename(string oldName, ChangeEventArgs e)
    {
        var newName = e.Value?.ToString()?.Trim() ?? "";
        _renameError = null;
        if (newName == oldName)
            return;
        if (NameProblem(newName, except: oldName) is { } problem)
        {
            _renameError = (oldName, problem);
            return;
        }

        Draft.Document.Params = Params.ToDictionary(kv => kv.Key == oldName ? newName : kv.Key, kv => kv.Value);
        if (_open.Remove(oldName))
            _open.Add(newName);
        await OnChanged.InvokeAsync();
    }

    private async Task Remove(string name)
    {
        // Rebuild rather than Remove, so a later Add can't reuse the freed slot and reorder the params.
        Draft.Document.Params = Params.Where(kv => kv.Key != name).ToDictionary(kv => kv.Key, kv => kv.Value);
        _open.Remove(name);
        await OnChanged.InvokeAsync();
    }

    public void Reset()
    {
        _open.Clear();
        _renameError = null;
        _addError = null;
    }
}
